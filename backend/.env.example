PORT=3000
NODE_ENV=development
PUBLIC_ORIGIN=http://localhost:5173

# Required — the server refuses to start without it. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# ── Database ────────────────────────────────────────────────────────────────
# Required. The API connects as the least-privilege role `tracechain_app`
# (created by migration 009). It cannot run DDL, cannot UPDATE/DELETE ledger
# rows, and is subject to row-level security. In production the server
# REFUSES to start if this points at a superuser / table owner.
DATABASE_URL=postgres://tracechain_app:tracechain_app_dev@localhost:55432/tracechain

# Used only by `npm run migrate` — a role that owns the schema. Falls back to
# DATABASE_URL if unset (fine only for throwaway local databases).
MIGRATION_DATABASE_URL=postgres://tracechain:tracechain_dev@localhost:55432/tracechain
# If set, `npm run migrate` also enables LOGIN for tracechain_app with this password.
APP_DB_PASSWORD=tracechain_app_dev

# TLS to Postgres: require | no-verify | (unset = plain, local only)
DATABASE_SSL=
# Optional pool tuning (defaults shown).
# DATABASE_POOL_MAX=10
# DATABASE_STATEMENT_TIMEOUT_MS=15000
# DATABASE_IDLE_TX_TIMEOUT_MS=30000
# DATABASE_CONNECT_TIMEOUT_MS=5000

# ── Ledger ──────────────────────────────────────────────────────────────────
# New events use hash v2 (public, salted SHA-256) and need no secret. This key
# is ONLY used to re-verify legacy v1 (HMAC) events recorded before v2. Keep
# the old value for as long as such events exist; unset it otherwise.
LEDGER_SIGNING_KEY=

# Only relevant when NODE_ENV=production: set to "true" to seed the demo
# accounts (including a demo ADMIN login) anyway, for a hosted demo. Leave
# unset for a real deployment.
SEED_DEMO_DATA=
